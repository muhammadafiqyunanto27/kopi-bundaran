---
import { siteInfo } from "../data/site";
---
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow">— sejak hari ini —</p>
      <h1>Kopi Bundaran</h1>
      <p class="tagline">{siteInfo.tagline}</p>
      <div class="hero-actions">
        <a href="#menu" class="btn">Lihat Menu</a>
        <a href="#kontak" class="btn outline">Kunjungi Kami</a>
      </div>
    </div>
    <div class="hero-art">
      <svg viewBox="0 0 200 200" class="cup" aria-hidden="true">
        <path d="M40 70 Q40 150 100 160 Q160 150 160 70 Z" fill="none" stroke="#1a1a1a" stroke-width="3" stroke-linecap="round"/>
        <path d="M160 85 Q195 85 195 115 Q195 145 160 145" fill="none" stroke="#1a1a1a" stroke-width="3" stroke-linecap="round"/>
        <path d="M70 40 Q75 20 85 40 Q95 20 105 40 Q115 20 125 40" fill="none" stroke="#1a1a1a" stroke-width="2.5" stroke-linecap="round"/>
        <ellipse cx="100" cy="72" rx="58" ry="10" fill="none" stroke="#1a1a1a" stroke-width="2"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .eyebrow { color: var(--gray); font-style: italic; margin: 0 0 0.5rem; }
  .hero h1 { font-size: clamp(3rem, 8vw, 5.5rem); margin: 0; line-height: 0.95; }
  .tagline { font-size: 1.3rem; color: var(--gray); margin: 0.75rem 0 1.25rem; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero-art { display: flex; flex-direction: column; align-items: center; }
  .cup { width: 100%; max-width: 260px; }
  @media (max-width: 720px) {
    .hero { padding: calc(var(--space) * 2) 0; }
    .hero-inner { grid-template-columns: 1fr; text-align: center; gap: 1rem; }
    .hero-actions { justify-content: center; }
    .cup { max-width: 160px; }
  }
</style>